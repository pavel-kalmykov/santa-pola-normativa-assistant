# LLM providers
# DeepSeek: main chat/RAG model (deepseek-chat). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenRouter: vision OCR (google/gemini-2.5-flash) for scanned PDF pages/diagrams.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Postgres (dlt staging tables: extracted/OCR'd text and metadata, not PDFs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=santapola
POSTGRES_PASSWORD=santapola
POSTGRES_DB=santapola

# MinIO (S3-compatible object storage for the downloaded PDF files themselves)
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=santapola
MINIO_SECRET_KEY=santapola123
MINIO_BUCKET=santa-pola-pdfs

# Qdrant (vector search)
QDRANT_URL=http://localhost:6333

# Elasticsearch (BM25 text search)
ELASTICSEARCH_URL=http://localhost:9200

# OpenTelemetry (traces exported to the local Tempo collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=santa-pola-rag
