# LLM providers
# Main chat/RAG model: any OpenAI-Chat-Completions-compatible provider works
# by changing these three, no code change needed. Defaults to Z.ai's coding
# plan (https://z.ai/subscribe). To fall back to OpenRouter instead (e.g. if
# credits run out, including a free model there):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-4.6 (or any model slug, including a ":free" one)
#   LLM_API_KEY=<your OpenRouter key>
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=glm-4.6
LLM_API_KEY=

# OpenRouter: vision OCR (google/gemini-2.5-flash) for scanned PDF pages/diagrams.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Postgres: dlt staging tables (extracted/OCR'd text and metadata, not PDFs)
# AND the pgvector vector store (santa_pola_vectors.chunks), same instance
# for both. SSL mode is only needed for a managed instance (e.g. Neon
# requires "require").
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=santapola
POSTGRES_PASSWORD=santapola
POSTGRES_DB=santapola
POSTGRES_SSLMODE=

# S3-compatible object storage for the downloaded PDF files themselves
# (MinIO locally, Cloudflare R2 or similar for a managed deployment)
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=santapola
MINIO_SECRET_KEY=santapola123
MINIO_BUCKET=santa-pola-pdfs

# OpenSearch (BM25 text search, and on managed deployments also the query
# log and feedback indexes). Credentials only needed for a managed
# deployment: Aiven uses basic auth (user avnadmin plus its password in
# OPENSEARCH_API_KEY); local docker-compose is unauthenticated.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_API_KEY=
OPENSEARCH_USER=

# OpenTelemetry (traces exported to the local Tempo collector). Headers are
# only needed for a managed endpoint (e.g. Grafana Cloud Tempo), in the
# standard "key1=value1,key2=value2" format, e.g.
# Authorization=Basic <base64(instanceID:apiToken)>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=santa-pola-rag
